APP_NAME=RepoPilot AI
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/repopilot
JWT_SECRET_KEY=change-this-secret-key-in-production-min-32-chars

# Directory where git clones are stored (relative or absolute path)
CLONE_BASE_DIR=clones

# Maximum file size included in discovery (bytes). Default: 1 MB.
MAX_FILE_SIZE_BYTES=1048576

# Maximum number of files accepted in one discovery run. Default: 10 000.
MAX_FILE_COUNT=10000

# Maximum total repository size accepted in one discovery run (bytes). Default: 500 MB.
MAX_REPO_SIZE_BYTES=524288000

# Maximum wall-clock seconds allowed for one discovery run. Default: 300.
MAX_DISCOVERY_SECONDS=300
